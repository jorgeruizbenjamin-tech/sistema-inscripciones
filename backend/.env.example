# Copia este archivo a ".env" y ajusta los valores

PORT=4000

# Conexión a PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=sis_academico
PGUSER=postgres
PGPASSWORD=postgres

# Firma de tokens JWT (cambiar en producción)
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173
